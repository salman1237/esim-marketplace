# ==========================================
# eSIM Marketplace Platform - Environment Configuration
# ==========================================

# Application Environment
NODE_ENV=production
ENVIRONMENT=production
PROJECT_NAME="eSIM Marketplace"

# Backend FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Required. Generate a unique value per environment, e.g.: openssl rand -hex 32
# The app refuses to start in production without this set to something other
# than the compiled-in development default.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL)
POSTGRES_USER=esim_user
POSTGRES_PASSWORD=esim_secure_password_2026
POSTGRES_DB=esim_db
POSTGRES_HOST=esim-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://esim_user:esim_secure_password_2026@esim-db:5432/esim_db

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
# What a visitor sees before choosing. The books stay in EUR (BASE_CURRENCY).
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Upstream Supplier: VivaPe API
VIVAPE_BASE_URL=https://app.vivape.net/api
VIVAPE_EMAIL=merchantusd@vivape.co
VIVAPE_PASSWORD=merchantusd@36
VIVAPE_CURRENCY=USD

# VivaPe's eSIM diagnostics endpoints pass the upstream carrier's own
# timestamps through with no timezone offset. This is the zone those naive
# values are assumed to be in; values that DO carry an offset ignore it.
# Symptom of a wrong setting: activation and expiry times consistently out by
# a whole number of hours. Everything is stored UTC and displayed in
# Bangladesh time regardless.
SUPPLIER_TIMEZONE=Asia/Hong_Kong

# Payment Gateway: ShurjoPay Sandbox
SHURJOPAY_BASE_URL=https://sandbox.shurjopayment.com
SHURJOPAY_USERNAME=sp_sandbox
SHURJOPAY_PASSWORD=pyyk97hu&6u6
SHURJOPAY_PREFIX=NOK
SHURJOPAY_RETURN_URL=https://triptel.co/api/v1/payments/shurjopay/callback
SHURJOPAY_CANCEL_URL=https://triptel.co/wallet?topup=cancelled

# Where the browser lands after GET /payments/shurjopay/callback finishes
# processing (the frontend's own origin, not this API's)
FRONTEND_BASE_URL=https://triptel.co

# Outgoing email (welcome, order confirmation, password reset). With
# SMTP_HOST or SMTP_USERNAME unset, EmailService logs a warning and sends
# nothing - password reset links are generated but never delivered.
#
# SMTP_PORT decides the encryption mode: 465 is implicit TLS (SMTPS) and
# 587 is STARTTLS (SMTP_USE_TLS applies only to 587). SMTP_HOST must be a
# name the server's TLS certificate actually covers, otherwise the
# connection fails certificate verification.
# For Gmail, SMTP_PASSWORD must be a Google App Password, not the account
# password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=hello@triptel.co
SMTP_FROM_NAME=Triptel

# Blind copy of every outgoing email - welcome, order, password reset,
# withdrawal, support, all of it. Set empty to switch it off.
NOTICE_BCC_EMAIL=triptel.com@gmail.com

# Currency API
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest

# CORS: comma-separated list of allowed frontend origins (no wildcards)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
